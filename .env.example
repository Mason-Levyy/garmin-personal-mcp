# All variables are optional. Run `garmin-personal-mcp auth` for the guided setup instead.

# Garmin Connect Personal API key, from
# https://connect.garmin.com/app/settings/personalApiToken. Overrides the saved
# key file (~/.config/garmin/connect-personal-api-key).
# GARMIN_PERSONAL_API_KEY=

# Where garmin_download_activity saves activity files (default: a garmin folder
# in your Downloads directory).
# GARMIN_MCP_DOWNLOAD_DIR=
